<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/SudContentFrame">

    <!-- Top container: dynamically scales the logo and welcome text -->
    <LinearLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Nested container for logo and welcome text -->
        <LinearLayout
            android:id="@+id/logo_welcome_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Logo ImageView with maximum height -->
            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="wrap_content"
                android:layout_height="457dp"
                android:layout_weight="2"
                android:adjustViewBounds="true"
                android:maxHeight="400dp"
                android:paddingTop="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <!-- Welcome TextView (text already set via style) with auto-size enabled -->
            <TextView
                android:id="@+id/welcome_title"
                style="@style/WelcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_weight="0"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:gravity="bottom|center"
                android:paddingTop="8dp"
                />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom container: always visible area for the Start button and extra controls -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="right"
        android:paddingBottom="16dp">

        <!-- Start button -->
        <Button
            android:id="@+id/start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start"
            style="@style/SudGlifButton.Primary" />

        <!-- Extra controls: emergency dialer and accessibility settings -->
        <LinearLayout
            android:id="@+id/extra_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <Button
                android:id="@+id/emerg_dialer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_dialer"
                android:text="@string/emergency_call"
                style="@style/SudGlifButton.Secondary" />

            <Button
                android:id="@+id/launch_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_eye"
                android:text="@string/accessibility_settings"
                style="@style/SudGlifButton.Secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
